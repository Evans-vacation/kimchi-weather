<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="화" android:textColor="#CCFFFFFF" android:textSize="10sp" android:maxLines="1"/>
    <ImageView android:id="@+id/w_icon" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="2dp" android:src="@drawable/ic_w_clear_day"/>
    <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="2dp" android:text="--°" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:maxLines="1"/>
</LinearLayout>
