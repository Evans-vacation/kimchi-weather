<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_clip" android:clipToOutline="true">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/scene_city_partly_day" android:importantForAccessibility="no"/>
    <ImageView android:id="@+id/scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/scrim" android:importantForAccessibility="no"/>
    <LinearLayout     android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp" >
        <TextView android:id="@+id/city" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="서울" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/temp" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="--°" android:textColor="#FFFFFF" android:textSize="42sp" android:fontFamily="sans-serif-light" android:maxLines="1"/>
            <ImageView android:id="@+id/icon" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_w_partly_day"/>
        </LinearLayout>
        <TextView android:id="@+id/cond" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="불러오는 중" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1"/>
        <TextView android:id="@+id/hl" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1"/>
        <TextView android:id="@+id/updated" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="#99FFFFFF" android:textSize="10sp" android:maxLines="1"/>
    </LinearLayout>
</FrameLayout>
