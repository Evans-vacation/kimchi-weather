<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_clip" android:clipToOutline="true">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/bg_clear_day" android:importantForAccessibility="no"/>
    <ImageView android:id="@+id/scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/scrim" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/city" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="서울" android:textColor="#FFFFFF" android:textSize="30sp" android:maxLines="1" android:textStyle="bold" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="10dp" android:layout_marginStart="6dp" android:gravity="start|top"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/dust" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#DDFFFFFF" android:textSize="11sp" android:maxLines="1" />
                <LinearLayout android:id="@+id/meter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal">
                <ImageView android:id="@+id/m1" android:layout_width="12dp" android:layout_height="6dp" android:scaleType="fitXY" android:src="@drawable/cell_off"/>
                <ImageView android:id="@+id/m2" android:layout_width="12dp" android:layout_height="6dp" android:layout_marginStart="2dp" android:scaleType="fitXY" android:src="@drawable/cell_off"/>
                <ImageView android:id="@+id/m3" android:layout_width="12dp" android:layout_height="6dp" android:layout_marginStart="2dp" android:scaleType="fitXY" android:src="@drawable/cell_off"/>
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/icon" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_w_partly_day"/>
                <TextView android:id="@+id/temp" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="44sp" android:maxLines="1" android:layout_marginStart="6dp" android:fontFamily="sans-serif-light" android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView android:id="@+id/cond" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="불러오는 중" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:layout_marginTop="2dp" android:gravity="center" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/tip" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:lineBreakWordStyle="phrase"/>
    </LinearLayout>
</FrameLayout>
